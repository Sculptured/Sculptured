{
  "name": "sculptured-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "test": "vitest run",
    "gen": "cd .. && cargo test --workspace export_bindings",
    "e2e": "playwright test",
    "e2e:layout": "playwright test -c playwright.layout.config.ts",
    "lint": "lint/node_modules/.bin/eslint --max-warnings 0 .",
    "duplication": "cd .. && web/node_modules/.bin/jscpd --config .jscpd.json web/src crates",
    "postinstall": "npm --prefix lint ci --no-audit --no-fund"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.1.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jscpd": "^5.4.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0"
}
