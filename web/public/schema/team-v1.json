{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sculptured.team/v1",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The file's JSON Schema, for editors that validate and complete it. Written on export; any value is\naccepted on import.",
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "description": "Always \"sculptured.team/v1\".",
      "type": "string",
      "pattern": "^sculptured\\.team/v1$"
    },
    "settings": {
      "$ref": "#/$defs/PortableSettings",
      "default": {
        "own_copies": false
      }
    },
    "team": {
      "$ref": "#/$defs/TeamDraft"
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "team"
  ],
  "$defs": {
    "AgentAdvanced": {
      "type": "object",
      "properties": {
        "authority": {
          "description": "The decisions this agent owns (MADL `authority`).",
          "anyOf": [
            {
              "$ref": "#/$defs/Authority"
            },
            {
              "type": "null"
            }
          ]
        },
        "check": {
          "description": "A shell command Sculptured runs in the agent's folder after each turn it finishes (exit 0 =\npassed). None = no check.",
          "type": [
            "string",
            "null"
          ]
        },
        "data_access": {
          "description": "What this agent reads and writes, and what else it changes (MADL `data_access`).",
          "anyOf": [
            {
              "$ref": "#/$defs/DataAccess"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrations": {
          "description": "The components it is given, by id: built in (`kindex`, `signet`) or one of the team's.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minute_limit": {
          "description": "Minutes this agent may spend working in one run (its children's included).",
          "anyOf": [
            {
              "$ref": "#/$defs/SoftHard"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "description": "This agent's own model, overriding its group's and team's default for its kind. None = inherit.",
          "type": [
            "string",
            "null"
          ]
        },
        "permission": {
          "$ref": "#/$defs/PermissionPosture",
          "default": "unrestricted"
        },
        "resume": {
          "$ref": "#/$defs/ResumeBehaviour",
          "default": "resume-if-possible"
        },
        "skills": {
          "description": "This agent's skills; only their names and descriptions are in its context until it uses one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Skill"
          }
        },
        "token_limit": {
          "description": "Tokens this agent may use in one run; reaching it soft-stops the agent. None = no limit.",
          "anyOf": [
            {
              "$ref": "#/$defs/TokenLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_limit": {
          "description": "Turns this agent may take in one run (its children's included).",
          "anyOf": [
            {
              "$ref": "#/$defs/SoftHard"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AgentKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ]
        },
        {
          "description": "Runs the stub driver: no model calls, no cost.",
          "type": "string",
          "const": "practice"
        }
      ]
    },
    "Authority": {
      "description": "The decisions an agent owns, in plain words.",
      "type": "object",
      "properties": {
        "domains": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "description": "How far its decisions reach: a group id, or `system` for the whole team. None: its own work.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "BoardPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "ClaudeSetup": {
      "description": "Which of the person's own Claude Code setup Claude agents load. Sculptured's own tools load either way.",
      "type": "object",
      "properties": {
        "global": {
          "description": "`~/.claude`: plugins, skills, hooks, settings and MCP servers. Off by default: a team's agents\nrarely need them, and every agent re-reads them on every model call.",
          "type": "boolean",
          "default": false
        },
        "project": {
          "description": "The agent folder's `.claude/` (settings, plugins, skills) and local settings. On by default.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "Component": {
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "briefing": {
          "description": "What agents given it are told about it.",
          "type": [
            "string",
            "null"
          ]
        },
        "claude_only": {
          "description": "Claude Code agents only (every tool hook is).",
          "type": "boolean"
        },
        "description": {
          "description": "What it gives an agent, in a sentence or two.",
          "type": "string"
        },
        "headers": {
          "description": "`mcp-remote`: request headers; each value names its secret as `${NAME}`.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "homepage": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Lowercase letters, digits and hyphens.",
          "type": "string"
        },
        "install": {
          "description": "How to set it up on a computer (install the program or plugin, get the secret), shown when it\nis missing. Not needed for skills.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "name": {
          "type": "string"
        },
        "plugin": {
          "description": "`claude-plugin`: the installed plugin, as `name@marketplace`.",
          "type": [
            "string",
            "null"
          ]
        },
        "program": {
          "description": "`mcp` and `tool-hook`: a program name (no path) the runner looks for on the agent's computer.",
          "type": "string"
        },
        "requires": {
          "description": "Other components it needs, by id; they come with it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "description": "`skills`: the skills it adds.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Skill"
          }
        },
        "url": {
          "description": "`mcp-remote`: the server's address, `https://` (or `http://` on this computer).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "kind"
      ]
    },
    "ComponentKind": {
      "oneOf": [
        {
          "description": "An MCP server over stdio: its tools sit next to Sculptured's.",
          "type": "string",
          "const": "mcp"
        },
        {
          "description": "A Claude Code PreToolUse hook run on every tool call, after Sculptured's own guard.",
          "type": "string",
          "const": "tool-hook"
        },
        {
          "description": "An MCP server at a web address (`url`); `${NAME}` in it and its headers is a secret the runner\nfills in on the agent's computer.",
          "type": "string",
          "const": "mcp-remote"
        },
        {
          "description": "Skills (`skills`), added to the agent's own; nothing runs.",
          "type": "string",
          "const": "skills"
        },
        {
          "description": "A Claude Code plugin installed on the agent's computer (`plugin`, `name@marketplace`), loaded\nfor that agent only.",
          "type": "string",
          "const": "claude-plugin"
        }
      ]
    },
    "ConnectionKind": {
      "oneOf": [
        {
          "description": "`delegates_to`: the giver starts before the receiver.",
          "type": "string",
          "const": "hands-work-to"
        },
        {
          "description": "`escalates_to`: design intent, not enforced.",
          "type": "string",
          "const": "reports-to"
        },
        {
          "description": "`can_observe`: design intent, not enforced.",
          "type": "string",
          "const": "watches"
        }
      ]
    },
    "ContinueMode": {
      "description": "How a run paused at a plan budget continues after its window resets.",
      "oneOf": [
        {
          "description": "Each agent starts a fresh conversation from the note it wrote when the run wrapped up.",
          "type": "string",
          "const": "notes"
        },
        {
          "description": "Each agent continues its own conversation (it re-reads all of it on every call).",
          "type": "string",
          "const": "resume"
        }
      ]
    },
    "CopiesMode": {
      "type": "string",
      "enum": [
        "shared",
        "per-item"
      ]
    },
    "DataAccess": {
      "description": "Paths relative to the agent's folder; a trailing `/` or `/**` covers a folder.",
      "type": "object",
      "properties": {
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shared": {
          "description": "Values other agents rely on, each with the file that holds it (an idea from Constrain's\nboundary register). Every start checks the file still contains it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SharedValue"
          }
        },
        "side_effects": {
          "description": "Effects beyond its files, in plain words.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DraftAgent": {
      "type": "object",
      "properties": {
        "advanced": {
          "$ref": "#/$defs/AgentAdvanced",
          "default": {
            "model": null,
            "permission": "unrestricted",
            "resume": "resume-if-possible"
          }
        },
        "folder": {
          "description": "Absolute path. Practice agents may leave it empty (they use the home folder).",
          "type": [
            "string",
            "null"
          ]
        },
        "group_id": {
          "description": "None = the default group (`DEFAULT_GROUP_ID`).",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Immutable; becomes the RigSpec member id.",
          "type": "string"
        },
        "job": {
          "description": "Plain-language instructions, sent as the agent's first message at start.",
          "type": "string",
          "default": ""
        },
        "kind": {
          "$ref": "#/$defs/AgentKind"
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "x",
        "y"
      ]
    },
    "DraftConnection": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConnectionKind"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "kind"
      ]
    },
    "DraftGroup": {
      "type": "object",
      "properties": {
        "h": {
          "type": "integer",
          "format": "int32"
        },
        "id": {
          "description": "Immutable; becomes the RigSpec pod id.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "models": {
          "description": "This group's model per provider; absent = inherit the team's.",
          "$ref": "#/$defs/ModelDefaults"
        },
        "w": {
          "type": "integer",
          "format": "int32"
        },
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "id",
        "label",
        "x",
        "y",
        "w",
        "h"
      ]
    },
    "Escalation": {
      "description": "After `after_rounds` rounds at a stage, its items go to `agent` (typically a stronger model's agent).",
      "type": "object",
      "properties": {
        "after_rounds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "agent": {
          "type": "string"
        }
      },
      "required": [
        "after_rounds",
        "agent"
      ]
    },
    "Guard": {
      "description": "A project check run every `every_minutes` while the team runs; while it fails, no new work goes out.",
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "every_minutes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "timeout_s": {
          "description": "Seconds before the guard command is stopped (default 600, at most 3600).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "command",
        "every_minutes"
      ]
    },
    "Join": {
      "description": "How a review panel decides: every reviewer, or the first approval.",
      "type": "string",
      "enum": [
        "all",
        "any"
      ]
    },
    "ModelDefaults": {
      "description": "Per-provider model defaults for a team or a group. None = inherit (group, then team, then the\nCLI's own default). An agent keeps its Claude-or-Codex kind and may override with `AgentAdvanced.model`.",
      "type": "object",
      "properties": {
        "claude": {
          "description": "For Claude agents: an alias (`opus`, `sonnet`) or a full model id.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "codex": {
          "description": "For Codex agents: a model slug (e.g. `gpt-6-sol`).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "PermissionPosture": {
      "type": "string",
      "enum": [
        "unrestricted",
        "restricted"
      ]
    },
    "PlanBudget": {
      "description": "A share of one plan window that a run may add, in percent of the window.",
      "type": "object",
      "properties": {
        "hard": {
          "type": "number",
          "format": "double"
        },
        "pause": {
          "description": "At the hard value: absent, every agent is stopped; set, the run pauses and continues by itself\nonce the window resets.",
          "anyOf": [
            {
              "$ref": "#/$defs/PlanPause"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "description": "`claude` or `codex`.",
          "type": "string"
        },
        "soft": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "window": {
          "description": "`five_hour` or `seven_day`.",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "window",
        "hard"
      ]
    },
    "PlanPause": {
      "description": "Pause at the hard value, then continue after the window resets, for at most `max_windows` windows.",
      "type": "object",
      "properties": {
        "continue_with": {
          "$ref": "#/$defs/ContinueMode",
          "default": "notes"
        },
        "max_windows": {
          "type": "integer",
          "format": "uint32",
          "default": 3,
          "minimum": 0
        }
      }
    },
    "PortableSettings": {
      "description": "The team settings that are part of its structure (not which computer runs it).",
      "type": "object",
      "properties": {
        "own_copies": {
          "description": "Each Claude Code / Codex agent works in its own git copy.",
          "type": "boolean",
          "default": false
        },
        "posture": {
          "description": "None: the global setting.",
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionPosture"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_timeout_min": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Protection": {
      "description": "A team's protections (Advanced). On by default.",
      "type": "object",
      "properties": {
        "context_tokens": {
          "description": "Past this many tokens of context, an agent writes its notes and continues fresh.",
          "type": "integer",
          "format": "uint32",
          "default": 60000,
          "minimum": 0
        },
        "on": {
          "type": "boolean",
          "default": true
        },
        "read_kb": {
          "description": "A read with no line range of a file larger than this many KB is refused.",
          "type": "integer",
          "format": "uint32",
          "default": 100,
          "minimum": 0
        },
        "shell_chars": {
          "description": "The most shell output, in characters, that reaches an agent's context.",
          "type": "integer",
          "format": "uint32",
          "default": 8000,
          "minimum": 0
        }
      }
    },
    "ResumeBehaviour": {
      "type": "string",
      "enum": [
        "resume-if-possible",
        "relaunch-fresh",
        "checkpoint-only"
      ]
    },
    "ReviewPersona": {
      "description": "An angle a review-panel reviewer takes, so a panel covers what one reviewer would miss.",
      "type": "string",
      "enum": [
        "red-team",
        "adversarial",
        "simplifier",
        "user",
        "expert",
        "good-friend",
        "ownership"
      ]
    },
    "RunBudget": {
      "description": "What one run of a team may use, all agents and their children together.",
      "type": "object",
      "properties": {
        "max_working": {
          "description": "Most agents working at the same time; the rest wait for a free slot.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "minutes": {
          "description": "Wall-clock minutes from Start.",
          "anyOf": [
            {
              "$ref": "#/$defs/SoftHard"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanBudget"
          }
        },
        "tokens": {
          "description": "Tokens of every kind (input, output, cache reads and writes).",
          "anyOf": [
            {
              "$ref": "#/$defs/SoftHard2"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SafetyRule": {
      "type": "object",
      "properties": {
        "conditions": {
          "description": "All must hold, such as `contains(parameters, 'rm -rf')` or `matches(file_path, '\\\\.env$')`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "reason": {
          "description": "What the agent is told when the rule refuses its call.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool_pattern": {
          "description": "A regular expression over the tool's name (`Bash`, `Write`, `mcp__…`). Default: every tool.",
          "type": "string",
          "default": ".*"
        }
      },
      "required": [
        "name"
      ]
    },
    "Schedule": {
      "description": "A message sent to `agent` every `every_minutes` while the team runs; skipped when the agent is busy.",
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "every_minutes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "agent",
        "every_minutes",
        "message"
      ]
    },
    "SharedValue": {
      "description": "A value at a boundary between agents, such as a port, an endpoint or a field name, and the file\n(relative to the agent's folder) that must contain it exactly.",
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "file"
      ]
    },
    "Skill": {
      "type": "object",
      "properties": {
        "body": {
          "description": "The instructions, in Markdown.",
          "type": "string"
        },
        "description": {
          "description": "When to use it: what the agent sees until it loads the skill.",
          "type": "string"
        },
        "name": {
          "description": "Lowercase letters, digits and hyphens.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "body"
      ]
    },
    "SoftHard": {
      "description": "A limit with a soft and a hard value. `soft` absent = 85% of `hard`.",
      "type": "object",
      "properties": {
        "hard": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "soft": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "hard"
      ]
    },
    "SoftHard2": {
      "description": "A limit with a soft and a hard value. `soft` absent = 85% of `hard`.",
      "type": "object",
      "properties": {
        "hard": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "soft": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "hard"
      ]
    },
    "StageKind": {
      "description": "Who runs a stage: an agent (default), Sculptured running a command, or a person.",
      "type": "string",
      "enum": [
        "agent",
        "check",
        "human",
        "merge"
      ]
    },
    "TeamDraft": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DraftAgent"
          }
        },
        "budget": {
          "description": "What one run may use (Advanced). Absent = no budget.",
          "$ref": "#/$defs/RunBudget"
        },
        "claude_setup": {
          "description": "Which of the person's own Claude Code setup Claude agents load (Advanced).",
          "$ref": "#/$defs/ClaudeSetup"
        },
        "components": {
          "description": "Components this team adds to Sculptured's built-in ones (from Community, or written by hand).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "connections": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DraftConnection"
          }
        },
        "decision_log": {
          "description": "People keep a decision log that agents read with read_decisions (Advanced).",
          "type": "boolean"
        },
        "folder": {
          "description": "Default working folder for agents without their own override.",
          "type": [
            "string",
            "null"
          ]
        },
        "groups": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DraftGroup"
          }
        },
        "id": {
          "description": "Immutable; becomes the rig name.",
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/TeamInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "description": "Limits on the agents this team's agents spawn (Advanced). Absent = no limits.",
          "$ref": "#/$defs/TeamLimits"
        },
        "models": {
          "description": "The team's model per provider; absent = the CLI's own default.",
          "$ref": "#/$defs/ModelDefaults"
        },
        "name": {
          "type": "string"
        },
        "protection": {
          "description": "Rules between this team's agents and their tools (Advanced). On by default.",
          "$ref": "#/$defs/Protection"
        },
        "revision": {
          "description": "Server-assigned save counter for optimistic concurrency.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "safety": {
          "description": "The team's safety rules (Advanced → Protections): tool calls they match are refused.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SafetyRule"
          }
        },
        "schedules": {
          "description": "Messages sent to an agent every N minutes while the team runs (Advanced).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Schedule"
          }
        },
        "workflow": {
          "anyOf": [
            {
              "$ref": "#/$defs/Workflow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "revision"
      ]
    },
    "TeamInput": {
      "description": "The project's Input box on the Design board: the goal, links and notes the agents it points\nto get with their Job when the team starts. (A workflow project uses its workflow's Input.)",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "to": {
          "description": "The agents (ids) it hands to.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "text",
        "x",
        "y"
      ]
    },
    "TeamLimits": {
      "description": "Limits a person set on a team's spawned agents. None = no limit; Sculptured sets none of its own.",
      "type": "object",
      "properties": {
        "max_agents": {
          "description": "Most agents in the team at once, its own and spawned children together.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_child_levels": {
          "description": "Most levels of children: 1 lets the team's agents spawn children that cannot spawn their own.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "TokenCount": {
      "description": "Which reported tokens count toward a limit.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "output"
          ]
        },
        {
          "description": "Input, output, cache reads and cache writes.",
          "type": "string",
          "const": "all"
        },
        {
          "description": "Everything except cache reads.",
          "type": "string",
          "const": "new"
        }
      ]
    },
    "TokenLimit": {
      "description": "A per-agent token limit for one run (since the team started).",
      "type": "object",
      "properties": {
        "counts": {
          "$ref": "#/$defs/TokenCount",
          "default": "all"
        },
        "include_subagents": {
          "description": "Count the agents it spawns (and theirs) toward this agent's limit.",
          "type": "boolean",
          "default": true
        },
        "soft": {
          "description": "The soft value: reaching it asks the agent to wrap up. Absent = 85% of `tokens`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tokens": {
          "description": "The hard value: reaching it stops the agent at once.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "tokens"
      ]
    },
    "Workflow": {
      "type": "object",
      "properties": {
        "collector": {
          "type": "string"
        },
        "copies": {
          "description": "per-item: each item gets its own git branch and folder (Advanced).",
          "$ref": "#/$defs/CopiesMode"
        },
        "dispatcher": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "guard": {
          "description": "Pauses new work while this project check fails (Advanced).",
          "anyOf": [
            {
              "$ref": "#/$defs/Guard"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "type": "string",
          "default": ""
        },
        "input_position": {
          "description": "Board placement only; changing it does not alter workflow execution.",
          "anyOf": [
            {
              "$ref": "#/$defs/BoardPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_steps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkflowStage"
          }
        }
      },
      "required": [
        "dispatcher",
        "entry",
        "collector",
        "max_tasks",
        "max_steps",
        "stages"
      ]
    },
    "WorkflowStage": {
      "type": "object",
      "properties": {
        "agent": {
          "description": "Empty for check and human stages.",
          "type": "string",
          "default": ""
        },
        "command": {
          "description": "check: the shell command, run in the team's project folder.",
          "type": [
            "string",
            "null"
          ]
        },
        "escalate": {
          "description": "Hands items to a stronger agent after a number of rounds here (single-agent stages).",
          "anyOf": [
            {
              "$ref": "#/$defs/Escalation"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "into": {
          "description": "merge: the branch to merge into (default: the project's current branch).",
          "type": [
            "string",
            "null"
          ]
        },
        "join": {
          "$ref": "#/$defs/Join"
        },
        "kind": {
          "$ref": "#/$defs/StageKind"
        },
        "max_rounds": {
          "description": "How often one item may enter this stage; entering past it takes `on_limit`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "on_limit": {
          "description": "The stage to take when `max_rounds` is reached; none blocks the item.",
          "type": [
            "string",
            "null"
          ]
        },
        "personas": {
          "description": "The angle each panel reviewer takes, by agent id (ideas from Advocate). None: its own judgement.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ReviewPersona"
          }
        },
        "position": {
          "description": "Board placement of the stage's own box (check, person, merge, review panel); none places it\nautomatically. Changing it does not alter workflow execution.",
          "anyOf": [
            {
              "$ref": "#/$defs/BoardPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "description": "Panel outcome order, worst first (default: blocked, then any non-\"approved\", then \"approved\").",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompt": {
          "description": "human: what the person decides. The outcomes are the route keys.",
          "type": [
            "string",
            "null"
          ]
        },
        "reviewers": {
          "description": "A review panel: 2–6 agents who all take the same item (instead of `agent`/`workers`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routes": {
          "description": "An outcome selects one route. Null completes this item; \"blocked\" is reserved.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "timeout_s": {
          "description": "check: seconds before the command is stopped (default 600, at most 3600).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "workers": {
          "description": "Additional interchangeable agents for concurrent topics at this stage.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "name",
        "routes"
      ]
    }
  }
}
